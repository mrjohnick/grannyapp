# Kopier til .env.local. Verdiene for lokal Supabase skrives ut av `pnpm db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Brukernavnet til boten fra @BotFather, uten @
VITE_TELEGRAM_BOT_USERNAME=GrannyBot

# Valgfri: Grimstad-utsnitt fra Protomaps (se README). Uten den brukes OSM-fliser i utvikling.
# VITE_PMTILES_URL=/maps/grimstad.pmtiles

# Valgfri: CSS med @font-face for Recoleta, Sofia Pro og Integral CF (lisensiert, ikke i repoet).
# Mal: docs/brand-fonts.example.css
# VITE_BRAND_FONTS_URL=/fonts/brand-fonts.css
